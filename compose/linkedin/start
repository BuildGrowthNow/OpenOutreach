#!/bin/bash
# compose/start_v2 - Start Next.js and FastAPI (Phase 3 - no Django)

set -euo pipefail

# Virtual display (always needed — Playwright launches headed mode)
rm -f /tmp/.X99-lock
Xvfb :99 -screen 0 1920x1080x24 &
sleep 1
export DISPLAY=:99

# Start Next.js frontend server on port 3000
echo "Starting Next.js server on port 3000..."
if [ -d /app/frontend ]; then
    cd /app/frontend
    gosu ubuntu node_modules/.bin/next start -p 3000 &
    NEXTJS_PID=$!

    sleep 2

    if ! kill -0 $NEXTJS_PID 2>/dev/null; then
        echo "Next.js process died immediately"
        exit 1
    fi

    ps -p $NEXTJS_PID
    echo "Next.js started with PID $NEXTJS_PID"
    cd /app

    # Wait for Next.js to be ready (up to 30 seconds)
    echo "Waiting for Next.js to be ready..."
    for i in $(seq 1 30); do
        if curl -sf http://localhost:3000 >/dev/null; then
            echo "Next.js is ready and listening on port 3000!"
            break
        fi
        if [ $i -eq 30 ]; then
            echo "ERROR: Next.js failed to start within 30 seconds"
            exit 1
        fi
        sleep 1
    done
else
    echo "ERROR: /app/frontend directory not found"
    NEXTJS_PID=""
fi

# VNC remote access (only for open-source local use)
if [ "${ENABLE_VNC:-false}" = "true" ]; then
    x11vnc -display :99 -forever -shared -nopw &
    websockify --web /opt/noVNC 6080 localhost:5900 &
fi

# Wait for Next.js to be ready
sleep 2

# If SKIP_DAEMON is set, run migrations and FastAPI in background
if [ "${SKIP_DAEMON:-false}" = "true" ]; then
    echo "SKIP_DAEMON=true - Starting FastAPI without daemon..."
    echo "Ensuring MongoDB indexes..."
    gosu ubuntu python -m openoutreach.cli ensure-indexes

    # Start FastAPI server on port 8001
    gosu ubuntu python -m openoutreach.cli runserver --host 0.0.0.0 --port 8001 &
    API_PID=$!
    echo "FastAPI started with PID $API_PID"

    wait -n $NEXTJS_PID $API_PID
    EXIT_CODE=$?
    echo "A server process exited with status $EXIT_CODE, shutting down..."
    kill $NEXTJS_PID 2>/dev/null || true
    kill $API_PID 2>/dev/null || true
    wait $NEXTJS_PID 2>/dev/null || true
    wait $API_PID 2>/dev/null || true
    exit $EXIT_CODE
fi

# Start FastAPI server in background (needed for frontend → API communication)
echo "Starting FastAPI server on port 8001..."
gosu ubuntu python -m openoutreach.cli runserver --host 0.0.0.0 --port 8001 &
API_PID=$!
echo "FastAPI started with PID $API_PID"

# Run the daemon (MongoDB-native task queue)
# Forward any arguments, e.g. --onboard <file>
echo "Starting daemon..."
gosu ubuntu python -m openoutreach.cli rundaemon "$@" &
DAEMON_PID=$!
echo "Daemon started with PID $DAEMON_PID"

# Wait for any process to exit
wait -n $NEXTJS_PID $API_PID $DAEMON_PID
EXIT_CODE=$?
echo "A process exited with status $EXIT_CODE, shutting down..."
kill $NEXTJS_PID 2>/dev/null || true
kill $API_PID 2>/dev/null || true
kill $DAEMON_PID 2>/dev/null || true
wait $NEXTJS_PID 2>/dev/null || true
wait $API_PID 2>/dev/null || true
wait $DAEMON_PID 2>/dev/null || true
exit $EXIT_CODE
