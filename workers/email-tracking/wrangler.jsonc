{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "email-tracking",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  "kv_namespaces": [
    { "binding": "EMAIL_EVENTS", "id": "2ead52d74795463dbe07c2aba20b2d11" },
    { "binding": "EMAIL_SUPPRESSED", "id": "bbf180f81e4d4d41aff193250dfc6ea9" }
  ],

  // Secrets (set via `wrangler secret put`):
  //   SECRET_KEY           — shared with Python backend for HMAC verification
  //   WORKER_WEBHOOK_SECRET — sent in X-Webhook-Secret header to backend
  //   BACKEND_URL          — e.g. https://api.lengrowth.com

  "routes": [
    { "pattern": "track.lengrowth.com", "custom_domain": true }
  ],

  "workers_dev": false,

  "observability": {
    "enabled": true
  }
}
